{
  "lease_ms": 300,
  "scenarios": [
    {
      "id": "claim",
      "steps": [
        ["CLAIM", "client-a"],
        ["STATUS"]
      ],
      "expect": {
        "state": "owned",
        "owner": "client-a"
      }
    },
    {
      "id": "touch",
      "steps": [
        ["CLAIM", "client-a"],
        ["WAIT", 200],
        ["TOUCH", "client-a"],
        ["WAIT", 200],
        ["STATUS"]
      ],
      "expect": {
        "state": "owned",
        "owner": "client-a"
      }
    },
    {
      "id": "release",
      "steps": [
        ["CLAIM", "client-a"],
        ["RELEASE", "client-a"],
        ["CLAIM", "client-b"]
      ],
      "expect": {
        "state": "owned",
        "owner": "client-b"
      }
    },
    {
      "id": "claim-conflict",
      "steps": [
        ["CLAIM", "client-a"],
        ["CLAIM", "client-b", "already_owned"],
        ["STATUS"]
      ],
      "expect": {
        "state": "owned",
        "owner": "client-a",
        "last_error": "already_owned"
      }
    },
    {
      "id": "takeover-not-expired",
      "steps": [
        ["CLAIM", "client-a"],
        ["TAKEOVER", "client-b", "not_expired"],
        ["STATUS"]
      ],
      "expect": {
        "state": "owned",
        "owner": "client-a",
        "last_error": "not_expired"
      }
    },
    {
      "id": "release-not-owner",
      "steps": [
        ["CLAIM", "client-a"],
        ["RELEASE", "client-b", "not_owner"],
        ["STATUS"]
      ],
      "expect": {
        "state": "owned",
        "owner": "client-a",
        "last_error": "not_owner"
      }
    },
    {
      "id": "takeover-idle",
      "steps": [
        ["CLAIM", "client-a"],
        ["RELEASE", "client-a"],
        ["TAKEOVER", "client-b", "not_expired"],
        ["STATUS"]
      ],
      "expect": {
        "state": "idle",
        "owner": null,
        "last_error": "not_expired"
      }
    },
    {
      "id": "takeover-unknown",
      "steps": [
        ["TAKEOVER", "client-a", "not_expired"],
        ["STATUS"]
      ],
      "expect": {
        "state": "idle",
        "owner": null,
        "last_error": "not_expired"
      }
    },
    {
      "id": "expiry-takeover",
      "steps": [
        ["CLAIM", "client-a"],
        ["WAIT", 400],
        ["TAKEOVER", "client-b"],
        ["TOUCH", "client-a"]
      ],
      "expect": {
        "state": "owned",
        "owner": "client-b",
        "last_error": "not_owner"
      }
    },
    {
      "id": "output-is-not-input",
      "steps": [
        ["CLAIM", "client-a"],
        ["EMIT_OUTPUT", 400],
        ["STATUS"]
      ],
      "expect": {
        "state": "expired",
        "owner": null,
        "min_output_bytes": 1
      }
    },
    {
      "id": "heartbeat-extends",
      "steps": [
        ["CLAIM", "client-a"],
        ["HEARTBEAT", "client-a", 200],
        ["WAIT", 200],
        ["HEARTBEAT", "client-a", 200],
        ["WAIT", 200],
        ["STATUS"]
      ],
      "expect": {
        "state": "owned",
        "owner": "client-a"
      }
    }
  ]
}
