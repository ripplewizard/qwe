{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QWE POC Test Result",
  "type": "object",
  "required": [
    "case_id",
    "language",
    "status",
    "source_commit",
    "environment",
    "command",
    "started_at",
    "duration_ms",
    "evidence",
    "known_limitations"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^(T|P|D|RM|DX|XP|EX|MC)[0-9]{2}$"
    },
    "language": {
      "enum": ["rust", "go", "cpp"]
    },
    "status": {
      "enum": ["pass", "fail", "blocked", "unsupported", "not-run"]
    },
    "source_commit": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "required": ["os", "architecture", "toolchain"],
      "additionalProperties": true
    },
    "command": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": ["number", "string", "boolean", "null"]
          },
          {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          }
        ]
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

